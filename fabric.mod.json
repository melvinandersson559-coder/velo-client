{
  "schemaVersion": 1,
  "id": "velocli",
  "version": "${version}",
  "name": "VELO Client",
  "description": "VELO Client 1.8.0 - Anti-aliased Clean Blue UI, Smooth 3D Title Screen, Glowing Underground Base/Spawner Finder, All-Blocks ESP, Freecam & Slow Swing.",
  "authors": ["VELO"],
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.velo.client.VeloClient"
    ],
    "modmenu": [
      "com.velo.client.VeloModMenuIntegration"
    ]
  },
  "mixins": [
    "velocli.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*"
  }
}
